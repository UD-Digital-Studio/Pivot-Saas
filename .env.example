# Ne placez aucune valeur secrète réelle dans ce fichier.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_PATH=
PAYMENT_GATEWAY=simulated
# PAYMENT_GATEWAY bascule automatiquement sur mesomb lorsque les 3 clés sont présentes.
# Vous pouvez utiliser MESOMB_APP_KEY ou MESOMB_APPLICATION_KEY.
MESOMB_APP_KEY=
MESOMB_APPLICATION_KEY=
MESOMB_ACCESS_KEY=
MESOMB_SECRET_KEY=
MESOMB_COUNTRY=CM
MESOMB_CURRENCY=XAF
MESOMB_CONNECT_TIMEOUT=5
MESOMB_READ_TIMEOUT=30
MESOMB_MAX_RETRIES=2
MESOMB_RETRY_BACKOFF=0.5
MESOMB_OPERATION_MODE=asynchronous

# SMTP réel — exemple TLS sur le port 587.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=PIVOT <noreply@example.com>
APP_BASE_URL=http://127.0.0.1:8000
SUBSCRIPTION_TRIAL_MONTHS=3
SUBSCRIPTIONS_ENABLED=true
SUBSCRIPTION_TRIAL_PLAN_CODE=professional
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_NOTICE_DAYS=7,3,1
SUBSCRIPTION_PAYMENT_RECHECK_MINUTES=2
MESOMB_USE_SYSTEM_PROXY=false
SERVER_EMAIL=noreply@example.com

# Assistant IA OpenRouter. Laissez la clé vide pour désactiver l'intégration.
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_CONNECT_TIMEOUT=5
OPENROUTER_READ_TIMEOUT=45
OPENROUTER_MAX_TOKENS=800
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_TITLE=PIVOT Engineering
AI_CONVERSATION_MAX_MESSAGES=100
AI_CONTEXT_MAX_MESSAGES=20
AI_MESSAGE_MAX_CHARS=8000
AI_CONVERSATION_RETENTION_DAYS=90
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_TOKEN_BUDGET_PER_WINDOW=50000
AI_DUPLICATE_WINDOW_SECONDS=30
AI_REQUEST_STALE_SECONDS=120
